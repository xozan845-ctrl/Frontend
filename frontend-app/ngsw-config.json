{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/icon.svg",
          "/pwa-install-capture.js",
          "/config.json",
          "/version.json",
          "/*.css",
          "/main-*.js"
        ]
      }
    },
    {
      "name": "lazy-chunks",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/chunk-*.js"]
      }
    }
  ]
}
