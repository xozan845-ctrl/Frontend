{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "01a61f6d-2567-4ffe-9e23-ca0138fcf15d"
  },
  "newProjectRoot": "projects",
  "projects": {
    "frontend-app": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "e2e": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.e2e.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "frontend-app:build:production"
            },
            "development": {
              "buildTarget": "frontend-app:build:development"
            },
            "e2e": {
              "buildTarget": "frontend-app:build:e2e"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "setupFiles": ["src/test-setup.ts"],
            "coverage": true,
            "coverageReporters": ["text", "lcov"],
            "coverageInclude": [
              "src/app/domains/**/adapters/**/*.ts",
              "src/app/domains/**/guards/**/*.ts",
              "src/app/domains/**/interceptors/**/*.ts",
              "src/app/domains/**/repositories/**/*.ts",
              "src/app/domains/**/services/**/*.ts",
              "src/app/domains/**/state/**/*.ts",
              "src/app/shared/models/**/*.ts",
              "src/app/shared/services/**/*.ts",
              "src/app/shared/utils/**/*.ts"
            ],
            "coverageExclude": [
              "src/**/*.spec.ts",
              "src/test-setup.ts",
              "src/app/**/mocks/**/*.ts"
            ],
            "coverageThresholds": {
              "statements": 80,
              "branches": 70,
              "functions": 80,
              "lines": 80
            }
          }
        }
      }
    }
  }
}
